{
  "name": "app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node node_modules/vite/bin/vite.js build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test": "node --test tests/simulation.test.mjs tests/baseline-output.test.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "simulate": "node scripts/run-baseline.mjs",
    "verify:docs": "node scripts/verify-doc-boundaries.mjs",
    "verify:sites-evidence": "node scripts/verify-doc-boundaries.mjs --sites",
    "verify": "npm run verify:docs && npm test && npm run build && npm run verify:sites-evidence && npm run test:sites && npm run simulate"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.1.0",
    "@xyflow/react": "12.11.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "vite": "8.2.2"
  }
}
